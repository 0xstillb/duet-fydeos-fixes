+static bool is_lenovo_duet_5_truncated_report_map(uint16_t len, const uint8_t* desc) {
+  static constexpr std::array<uint8_t, SHA256_DIGEST_LENGTH> kTruncatedReportMapSha256 = {
+          0x26, 0x2e, 0xd0, 0x64, 0xb3, 0xa7, 0x01, 0x84, 0x6b, 0x7f, 0xd6,
+          0xeb, 0x4a, 0x7c, 0x7c, 0xe8, 0x2f, 0xf2, 0x80, 0x9c, 0xb1, 0xf1,
+          0xbe, 0x71, 0xb4, 0x2a, 0x07, 0xe1, 0xb3, 0x0e, 0xfd, 0x0b};
+
+  if (len != GATT_MAX_ATTR_LEN) return false;
+
+  std::array<uint8_t, SHA256_DIGEST_LENGTH> digest;
+  SHA256(desc, len, digest.data());
+  return digest == kTruncatedReportMapSha256;
+}
